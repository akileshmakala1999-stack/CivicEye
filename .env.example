# CivicEye — Environment Configuration
# When connected to Supabase, newly submitted reports and evidence photos sync to your remote database.
# In Demo Mode (empty keys), reports persist seamlessly to browser local storage.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google Gemini or Custom AI Vision Provider (Server-Side or Direct Proxy)
# When omitted, CivicEye runs its built-in deterministic heuristic intelligence engine with 100% functionality.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
