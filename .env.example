# ==============================================================================
# CIVICEYE — ENVIRONMENT CONFIGURATION (STAGE 13)
# ==============================================================================
# Copy this file to '.env' or '.env.local' and provide your project credentials.
#
# SECURITY NOTICE:
# - ONLY provide public client credentials (VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY).
# - NEVER expose your Supabase 'service_role' key, database password, or secret tokens.
# - Role-Based Access Control and Row Level Security are enforced on the Supabase backend.
# ==============================================================================

# Supabase Project API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Publishable API Key (Browser-safe anon key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google Gemini API Key for Live Multi-Modal Vision Triage
# If omitted, CivicEye runs its built-in deterministic heuristic civic intelligence engine with 100% functionality.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
